<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the standalone executable for submission: one Yahtzee.exe that runs on any 64-bit Windows 11 PC
  without installing .NET (the runtime and the native SQLite library are bundled inside it).
  Use:  dotnet publish src/Yahtzee.WinForms -p:PublishProfile=Standalone
  or, in Visual Studio: right-click Yahtzee.WinForms > Publish > Standalone.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Only the .exe is needed: no debug symbols or XML documentation files next to it. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
