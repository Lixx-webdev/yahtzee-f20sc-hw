<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Yahtzee.Core</RootNamespace>
    <!-- XML doc comments on public APIs feed the developer guide; missing ones fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yahtzee.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite database engine for the games history (bundles the native SQLite library). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
